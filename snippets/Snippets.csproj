<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MewUI.Site.Snippets</RootNamespace>
    <!-- The examples declare locals to show the API, then do not use them. -->
    <NoWarn>$(NoWarn);CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI" Version="$(MewUIPackageVersion)" />
  </ItemGroup>

</Project>
