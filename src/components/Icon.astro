---
interface Props {
  name: keyof typeof paths;
  size?: number;
}

// A small hand drawn set, so the page pulls in no icon dependency.
const paths = {
  chip: '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M4 10h3M4 14h3M17 10h3M17 14h3M10 4v3M14 4v3M10 17v3M14 17v3"/>',
  feather:
    '<path d="M4 20 20 4"/><path d="M14 4h6v6a8 8 0 0 1-8 8H8v-4a8 8 0 0 1 6-6Z"/><path d="M9 15h5"/>',
  brackets:
    '<path d="M9 5 5 12l4 7"/><path d="m15 5 4 7-4 7"/><path d="M13 8l-2 8"/>',
  targets:
    '<rect x="2" y="4" width="14" height="10" rx="2"/><path d="M6 18h6"/><rect x="17" y="10" width="5" height="10" rx="1.5"/>',
  download: '<path d="M12 3v11"/><path d="m7 10 5 5 5-5"/><path d="M4 19h16"/>',
  pen: '<path d="M4 20h4L20 8l-4-4L4 16Z"/><path d="m14 6 4 4"/>',
  refresh:
    '<path d="M4 12a8 8 0 0 1 13.5-5.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.5 5.8L4 16"/><path d="M4 20v-4h4"/>',
  ship: '<path d="m12 3 8 4v6l-8 4-8-4V7Z"/><path d="m4 7 8 4 8-4"/><path d="M12 11v10"/>',
  dock: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/><path d="M9 12h12"/>',
  vector:
    '<path d="M4 16c6 0 10-8 16-8"/><rect x="2" y="14" width="4" height="4" rx="1"/><rect x="18" y="6" width="4" height="4" rx="1"/>',
  brush:
    '<path d="M4 20c0-2 1-3 3-3s3 1 3 3-1.5 1.5-3 1.5S4 21 4 20Z"/><path d="m9 16 9-9a2.1 2.1 0 0 0-3-3l-9 9"/>',
  chart: '<path d="M4 20V4"/><path d="M4 20h16"/><path d="M8 16v-5M12 16V7M16 16v-8"/>',
  // A circle reads smaller than the square glyphs at the same bounding box, so
  // the globe is drawn wider than the 4 to 20 span the others use.
  globe:
    '<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5a15.5 15.5 0 0 1 0 19 15.5 15.5 0 0 1 0-19Z"/>',
  robot:
    '<rect x="4" y="8" width="16" height="11" rx="3"/><path d="M12 4v4"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/><path d="M10 16h4"/>',
  book: '<path d="M5 4h9a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3Z"/><path d="M17 7h2v13H8"/>',
  ruler:
    '<path d="m3 15 12-12 6 6-12 12Z"/><path d="m7 11 2 2M10 8l2 2M13 5l2 2"/>',
  star: '<path d="m12 4 2.5 5.1 5.5.8-4 3.9 1 5.5-5-2.7-5 2.7 1-5.5-4-3.9 5.5-.8Z"/>',
  windows:
    '<path d="M3 6.5 10.5 5v6H3Z"/><path d="M12.5 4.7 21 3v8h-8.5Z"/><path d="M3 13h7.5v6L3 17.5Z"/><path d="M12.5 13H21v8l-8.5-1.7Z"/>',
  linux:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 10 2.5 2L7 14"/><path d="M12 15h5"/>',
  apple:
    '<path d="M15.5 12.4c0-2 1.6-3 1.7-3.1a3.8 3.8 0 0 0-3-1.6c-1.3-.1-2.5.7-3.1.7s-1.6-.7-2.7-.7A4 4 0 0 0 5 9.8C3.6 12.2 4.6 16 6 18c.7 1 1.5 2.1 2.6 2 1-.1 1.4-.7 2.6-.7s1.6.7 2.7.6c1.1 0 1.8-1 2.5-2a9 9 0 0 0 1.1-2.3 3.6 3.6 0 0 1-2-3.2Z"/><path d="M13.6 6.2A3.5 3.5 0 0 0 14.4 4a3.6 3.6 0 0 0-2.3 1.2 3.3 3.3 0 0 0-.8 2.1 3 3 0 0 0 2.3-1.1Z"/>',
} as const;

const { name, size = 22 } = Astro.props;
const path = paths[name];
if (path === undefined) {
  throw new Error(`Icon "${name}" is not in the set.`);
}
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>

<style>
  .icon {
    display: block;
    flex: none;
  }
</style>
