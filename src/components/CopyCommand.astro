---
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="copy-command">
  <pre><code>{command}</code></pre>
  <button type="button" data-command={command} aria-label="Copy command">
    Copy
  </button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".copy-command button",
  )) {
    button.addEventListener("click", async () => {
      const command = button.dataset.command ?? "";
      try {
        await navigator.clipboard.writeText(command);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Press Ctrl+C";
      }
      setTimeout(() => {
        button.textContent = "Copy";
      }, 1600);
    });
  }
</script>

<style>
  .copy-command {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    background: var(--code-bg);
    border-radius: var(--radius);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
  }

  pre {
    margin: 0;
    /* A flex item defaults to min-width:auto, which lets the command push the
       box wider instead of scrolling inside it. */
    flex: 1 1 0;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    color: var(--code-fg);
    font-size: 0.9rem;
    line-height: 2.2;
  }

  button {
    flex: none;
    align-self: center;
    padding: 0.5rem 0.9rem;
    border: 1px solid #ffffff2e;
    border-radius: 8px;
    background: transparent;
    color: var(--code-fg);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
