---
import upstream from "../data/upstream.json";
import type { Copy } from "../copy/en";
import { links, base, asset } from "../config";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const { title, description } = copy;
const localeHref = (path: string) => `${base}${path}`;

// Unset until the counter worker is deployed, which keeps the beacon out of the
// built pages entirely.
const countUrl = import.meta.env.PUBLIC_COUNT_URL;
---

<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(asset("logo_h-1280.webp"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={asset("logo.svg")} type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" hreflang="en" href={new URL(localeHref("/"), Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(localeHref("/ko/"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localeHref("/"), Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localeHref(copy.path)}>
        <img src={asset("logo_h-480.png")} alt="MewUI" width="480" height="135" />
      </a>
      <nav>
        <a href={links.docs}>{copy.nav.docs}</a>
        <a href={links.nuget}>{copy.nav.nuget}</a>
        <a href={links.repo}>{copy.nav.github}</a>
        <a class="locale" href={localeHref(copy.otherLocalePath)}>
          {copy.otherLocaleLabel}
        </a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={asset("logo_h-480.png")} alt="MewUI" width="480" height="135" />
          <p class="muted">{copy.footer.tagline}</p>
        </div>
        <div>
          <h3>{copy.footer.project}</h3>
          <a href={links.repo}>GitHub</a>
          <a href={links.docs}>{copy.footer.documentation}</a>
          <a href={links.nuget}>NuGet</a>
          <a href={links.gallery}>{copy.footer.demo}</a>
        </div>
        <div>
          <h3>{copy.footer.community}</h3>
          <a href={`${links.repo}/blob/main/CONTRIBUTING.md`}>{copy.footer.contributing}</a>
          <a href={`${links.repo}/blob/main/.github/CODE_OF_CONDUCT.md`}>{copy.footer.codeOfConduct}</a>
          <a href={`${links.repo}/blob/main/THIRD_PARTY_NOTICES.md`}>{copy.footer.notices}</a>
          <a href={`${links.repo}/blob/main/LICENSE`}>{copy.footer.license}</a>
        </div>
      </div>
      <p class="muted small">{copy.footer.version(upstream.publishedVersion)}</p>
    </footer>
    {
      countUrl && (
        <script is:inline define:vars={{ countUrl }}>
          // Fire and forget. The page never reads the result, so an unreachable
          // counter changes nothing a visitor can see.
          try {
            fetch(countUrl + "/hit", {
              method: "POST",
              headers: { "content-type": "text/plain" },
              body: location.pathname,
              keepalive: true,
              mode: "cors",
            }).catch(() => {});
          } catch {}
        </script>
      )
    }
  </body>
</html>

<style is:global>
  /* MewUI's own palette: ThemeSeed.DefaultLight / DefaultDark for the neutrals,
     the built-in Purple accent for the highlight. */
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --bg-soft: #ffffff;
    --fg: #1e1e1e;
    --muted: #5f5f66;
    --accent: #8f54db;
    --accent-strong: #7c40cc;
    --accent-soft: #f4ecfc;
    --line: #e8e8e8;
    --code-bg: #1e1e1e;
    --code-fg: #e8e8e8;
    --radius: 12px;
    --page: 68rem;
    --font-sans:
      "Inter", system-ui, -apple-system, "Segoe UI", "Malgun Gothic", sans-serif;
    --font-display: "Space Grotesk", var(--font-sans);
    --font-mono:
      "JetBrains Mono", ui-monospace, "Cascadia Code", "Consolas", monospace;
  }

  /* Paperlogy, SIL Open Font License. Only the Korean page references this
     family, so the files download there and nowhere else. */
  @font-face {
    font-family: "Paperlogy";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/gh/fonts-archive/Paperlogy/Paperlogy-4Regular.woff2")
      format("woff2");
  }

  @font-face {
    font-family: "Paperlogy";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/gh/fonts-archive/Paperlogy/Paperlogy-6SemiBold.woff2")
      format("woff2");
  }

  @font-face {
    font-family: "Paperlogy";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/gh/fonts-archive/Paperlogy/Paperlogy-7Bold.woff2")
      format("woff2");
  }

  /* Inter and Space Grotesk carry no Hangul, so the Korean page leads with
     the Korean face and takes its Latin from the same family. */
  :root:lang(ko) {
    --korean-face: "Paperlogy";
    --font-sans:
      var(--korean-face), "Inter", system-ui, -apple-system, "Malgun Gothic",
      sans-serif;
    --font-display: var(--korean-face), var(--font-sans);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-feature-settings: "cv05", "ss03";
    font-size: 1.05rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  code,
  pre {
    font-family: var(--font-mono);
  }

  section {
    max-width: var(--page);
    margin: 0 auto;
    padding: 4.5rem 1.25rem;
  }

  section > h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  section > h2 + .lede {
    margin: 0 0 2.5rem;
    color: var(--muted);
    max-width: 46rem;
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: 0.88rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .brand img {
    width: auto;
    height: 2.1rem;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.25rem;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  /* The plain links are inline and the language pill is padded, so their text
     sat on different lines until both became flex boxes of the same height. */
  .site-header nav a {
    display: inline-flex;
    align-items: center;
    line-height: 1.2;
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--accent);
  }

  .site-header nav .locale {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  /* The four nav items plus the wordmark overflow a phone, and a wrapped
     header pushes the hero down, so both sides shrink instead. */
  @media (max-width: 34rem) {
    .site-header {
      padding: 0.6rem 0.9rem;
      gap: 0.6rem;
    }

    .brand img {
      height: 1.65rem;
    }

    .site-header nav {
      gap: 0.7rem;
      font-size: 0.82rem;
    }

    .site-header nav .locale {
      padding: 0.1rem 0.45rem;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 3rem 1.25rem 2.5rem;
  }

  .footer-grid {
    max-width: var(--page);
    margin: 0 auto 2rem;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .footer-grid h3 {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg);
  }

  .footer-grid a {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 0.15rem 0;
    font-size: 0.95rem;
  }

  .footer-grid a:hover {
    color: var(--accent);
  }

  .footer-logo {
    width: auto;
    height: 2rem;
    margin-bottom: 0.9rem;
  }

  .site-footer > .muted {
    max-width: var(--page);
    margin: 0 auto;
  }
</style>
