---
import upstream from "../data/upstream.json";
import { links, base, asset } from "../config";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(asset("logo_h-1280.webp"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={asset("logo.svg")} type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base === "" ? "/" : `${base}/`}>
        <img src={asset("logo.svg")} alt="" width="28" height="28" />
        <span>MewUI</span>
      </a>
      <nav>
        <a href={links.docs}>Docs</a>
        <a href={links.nuget}>NuGet</a>
        <a href={links.repo}>GitHub</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <img class="footer-logo" src={asset("logo.svg")} alt="MewUI" width="32" height="32" />
          <p class="muted">
            A cross-platform, lightweight, code-first .NET GUI framework.
            Released under the MIT License.
          </p>
        </div>
        <div>
          <h3>Project</h3>
          <a href={links.repo}>GitHub</a>
          <a href={links.docs}>Documentation</a>
          <a href={links.nuget}>NuGet</a>
          <a href={links.gallery}>Browser demo</a>
        </div>
        <div>
          <h3>Community</h3>
          <a href={`${links.repo}/blob/main/CONTRIBUTING.md`}>Contributing</a>
          <a href={`${links.repo}/blob/main/.github/CODE_OF_CONDUCT.md`}>Code of conduct</a>
          <a href={`${links.repo}/blob/main/THIRD_PARTY_NOTICES.md`}>Third party notices</a>
          <a href={`${links.repo}/blob/main/LICENSE`}>License</a>
        </div>
      </div>
      <p class="muted small">
        Version {upstream.publishedVersion} on NuGet. In loving memory of April.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  /* MewUI's own palette: ThemeSeed.DefaultLight / DefaultDark for the neutrals,
     the built-in Purple accent for the highlight. */
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --bg-soft: #ffffff;
    --fg: #1e1e1e;
    --muted: #5f5f66;
    --accent: #8f54db;
    --accent-strong: #7c40cc;
    --accent-soft: #f4ecfc;
    --line: #e8e8e8;
    --code-bg: #282a36;
    --code-fg: #f8f8f2;
    --radius: 12px;
    --page: 68rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1e1e1e;
      --bg-soft: #1a1a1b;
      --fg: #e6e6e8;
      --muted: #a3a3aa;
      --accent: #9e65e8;
      --accent-strong: #ae7cf0;
      --accent-soft: #271c3a;
      --line: #303032;
      --code-bg: #282a36;
      --code-fg: #f8f8f2;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family:
      system-ui,
      -apple-system,
      "Segoe UI",
      "Malgun Gothic",
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  code,
  pre {
    font-family: ui-monospace, "Cascadia Code", "Consolas", monospace;
  }

  section {
    max-width: var(--page);
    margin: 0 auto;
    padding: 4.5rem 1.25rem;
  }

  section > h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  section > h2 + .lede {
    margin: 0 0 2.5rem;
    color: var(--muted);
    max-width: 46rem;
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: 0.85rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    font-weight: 650;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.95rem;
  }

  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--accent);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
    padding: 3rem 1.25rem 2.5rem;
  }

  .footer-grid {
    max-width: var(--page);
    margin: 0 auto 2rem;
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .footer-grid h3 {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .footer-grid a {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 0.15rem 0;
    font-size: 0.95rem;
  }

  .footer-grid a:hover {
    color: var(--accent);
  }

  .footer-logo {
    margin-bottom: 0.75rem;
  }

  .site-footer > .muted {
    max-width: var(--page);
    margin: 0 auto;
  }
</style>
