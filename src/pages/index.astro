---
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";
import upstream from "../data/upstream.json";
import { links, asset } from "../config";
import { snippet } from "../lib/snippet";

const MIB = 1024 * 1024;
const mib = (bytes: number) => (bytes / MIB).toFixed(2);
const compact = (value: number) =>
  value >= 1000 ? `${(value / 1000).toFixed(1)}K` : String(value);

const helloRows = upstream.sizes.entries.filter(
  (entry) => entry.sample === "Hello World",
);
const galleryRows = upstream.sizes.entries.filter(
  (entry) => entry.sample === "Gallery",
);
const smallestHello = helloRows.reduce((a, b) =>
  a.executableBytes <= b.executableBytes ? a : b,
);
const measuredOn = new Date(upstream.sizes.generatedAtUtc)
  .toISOString()
  .slice(0, 10);

const stats = [
  { value: compact(upstream.stats.downloads), label: "NuGet downloads" },
  { value: String(upstream.stats.stars), label: "GitHub stars" },
  { value: String(upstream.stats.releases), label: "Releases shipped" },
  { value: "4", label: "Targets: Windows, Linux, macOS, browser" },
];

const highlights = [
  {
    title: "NativeAOT and trimming first",
    body: "Explicit code paths and source generated interop, with no reflection based binding. Publish a single native executable that runs without a .NET runtime installed.",
  },
  {
    title: "Small by design",
    body: `A Hello World window publishes at ${mib(smallestHello.executableBytes)} MiB. Low memory footprint and fast first frame follow from the same choices.`,
  },
  {
    title: "C# markup, no XAML",
    body: "Build the UI tree with a fluent API in plain C#. No markup compiler, no designer, no separate language to learn.",
  },
  {
    title: "One codebase, four targets",
    body: "Windows, Linux/X11 and macOS desktop hosts, plus a WebAssembly build that runs the same UI in the browser.",
  },
];

const workflow = [
  {
    step: "1",
    title: "Install",
    body: "dotnet add package Aprillz.MewUI, or drop a single .cs file with a package header and run it.",
  },
  {
    step: "2",
    title: "Write",
    body: "Compose controls with fluent C# markup and bind them to plain view models with explicit, reflection free paths.",
  },
  {
    step: "3",
    title: "Iterate",
    body: "Hot Reload applies edits to the running app. Editor Preview renders the window inside the IDE. DevTools inspects the live tree.",
  },
  {
    step: "4",
    title: "Publish",
    body: "Publish NativeAOT per platform, pick a single rendering backend to trim further, and ship one executable.",
  },
];

const extensions = [
  {
    name: "MewDock",
    body: "Visual Studio style docking: document and tool tabs, drag rearranging, splits, auto hide, popouts.",
    href: `${links.repo}/tree/main/extensions/MewUI.MewDock`,
  },
  {
    name: "SVG",
    body: "Pure C# SVG parsing and rendering. No System.Drawing, AOT compatible.",
    href: `${links.repo}/tree/main/extensions/MewUI.Svg`,
  },
  {
    name: "Skia",
    body: "SkiaCanvasView for drawing with SkiaSharp, with zero copy GPU interop per backend.",
    href: `${links.repo}/tree/main/extensions/MewUI.Skia`,
  },
  {
    name: "MewCharts",
    body: "Cartesian, pie and polar charts on the LiveChartsCore engine, without a SkiaSharp dependency.",
    href: `${links.repo}/tree/main/extensions/MewUI.MewCharts`,
  },
  {
    name: "WebView2",
    body: "Win32 WebView2 control. Requires the Microsoft Edge WebView2 runtime.",
    href: `${links.repo}/tree/main/extensions/MewUI.WebView2.Win32`,
  },
];

const platforms = [
  { platform: "Windows 10+", host: "Win32", backends: "Direct2D, GDI, MewVG" },
  { platform: "Linux", host: "X11", backends: "MewVG (OpenGL)" },
  { platform: "macOS 12+", host: "AppKit", backends: "MewVG (Metal)" },
  { platform: "Browser", host: "WebAssembly", backends: "MewVG (WebGL2)" },
];

const docs = [
  ["Installation and packages", "Installation.md"],
  ["C# markup", "CSharpMarkup.md"],
  ["Binding", "Binding.md"],
  ["Layout", "Layout.md"],
  ["Styling", "Styling.md"],
  ["Theme", "Theme.md"],
  ["Property system", "PropertySystem.md"],
  ["Items and templates", "ItemsAndTemplates.md"],
  ["Control template", "ControlTemplate.md"],
  ["Custom controls", "CustomControls.md"],
  ["Command system", "CommandSystem.md"],
  ["Application lifecycle", "ApplicationLifecycle.md"],
  ["Hot reload", "HotReload.md"],
  ["Editor preview", "Preview.md"],
];

const helloCode = snippet("Program.cs", "hello");
const bindingCode = snippet("BindingExample.cs", "binding");

const title = "MewUI";
const description =
  "A cross-platform, lightweight, code-first .NET GUI framework for NativeAOT and trim friendly desktop apps.";
---

<Base title={title} description={description}>
  <section class="hero">
    <div>
      <img class="wordmark" src={asset("logo_h-1280.webp")} alt="MewUI" width="420" height="184" />
      <h1>Desktop apps in C#, shipped as one small native file.</h1>
      <p class="lede">
        MewUI is a cross-platform, lightweight, code-first .NET GUI framework.
        No XAML, no designer, no .NET runtime on the target machine.
      </p>
      <div class="actions">
        <a class="primary" href={links.gallery}>Run the demo in your browser</a>
        <a href={links.install}>Get started</a>
        <a href={links.repo}>GitHub</a>
      </div>
      <p class="small muted">
        MIT licensed. .NET {upstream.targetFrameworks.join(" and ").replace(/net/g, "")}.
        Latest release {upstream.publishedVersion}.
      </p>
    </div>
    <picture class="shot">
      <img src={asset("dark.png")} alt="The MewUI Gallery sample running with the dark theme" width="1200" height="800" loading="eager" />
    </picture>
  </section>

  <div class="stat-band">
    <div class="stat-row">
      {stats.map((stat) => (
        <div class="stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <section id="try">
    <h2>Try it before you install anything</h2>
    <p class="lede">
      One command downloads a single file sample and runs it. No clone, no
      project, no SDK template. Requires the .NET 10 SDK.
    </p>
    <CopyCommand command={upstream.tryCommand} />
    <p class="small muted note">
      This downloads and executes code from GitHub. Read
      <a href={`${links.repo}/blob/main/samples/FBASample/fba_gallery.cs`}>the file</a>
      first if that matters to you. Prefer not to run anything?
      <a href={links.gallery}>The same Gallery runs in your browser.</a>
    </p>
  </section>

  <section id="why">
    <h2>Why MewUI</h2>
    <p class="lede">
      The framework optimizes for one thing: a small, self contained desktop app
      that starts fast.
    </p>
    <div class="cards">
      {highlights.map((item) => (
        <article class="card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="size">
    <h2>Measured, not claimed</h2>
    <p class="lede">
      Every number below is the main executable of a NativeAOT publish, measured
      by the repository's own size tooling. Binary units, so 1 MB is 1024 KB.
    </p>
    <div class="size-headline">
      <div>
        <strong>{mib(smallestHello.executableBytes)}<span> MiB</span></strong>
        <p>Hello World, {smallestHello.platformBackend}</p>
      </div>
      <div>
        <strong>{mib(galleryRows[0].executableBytes)}<span> MiB</span></strong>
        <p>Gallery, the full control showcase, {galleryRows[0].platformBackend}</p>
      </div>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Platform / backend</th>
            <th>Hello World</th>
            <th>Gallery</th>
          </tr>
        </thead>
        <tbody>
          {helloRows.map((hello) => {
            const gallery = galleryRows.find(
              (row) => row.platformBackend === hello.platformBackend,
            );
            return (
              <tr>
                <td>{hello.platformBackend}</td>
                <td>{mib(hello.executableBytes)} MiB</td>
                <td>{gallery ? `${mib(gallery.executableBytes)} MiB` : "-"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="small muted">
      Measured on {upstream.sizes.measuredOnVersion} at {measuredOn}.
      <a href={links.sizeTools}>Reproduce it with the size tools.</a>
    </p>
  </section>

  <section id="code">
    <h2>The whole app is C#</h2>
    <p class="lede">
      Controls are composed with a fluent API. What you read is what runs, and
      every example on this page is compiled against the published package.
    </p>
    <div class="code-grid">
      <pre class="code"><code>{helloCode}</code></pre>
      <div>
        <h3>Bindings without reflection</h3>
        <p class="muted">
          Sources are observable values, ordinary INotifyPropertyChanged view
          models, or another element's property. Paths are decomposed at compile
          time, so trimming and AOT keep working.
        </p>
        <pre class="code"><code>{bindingCode}</code></pre>
      </div>
    </div>
  </section>

  <section id="workflow">
    <h2>How you work</h2>
    <ol class="steps">
      {workflow.map((item) => (
        <li>
          <span class="step">{item.step}</span>
          <h3>{item.title}</h3>
          <p class="muted">{item.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="ai">
    <h2>Built to be driven by coding agents</h2>
    <p class="lede">
      MewUI ships an agent skill that teaches Claude Code, Codex and GitHub
      Copilot the package layout, the markup API and the build recipes, so an
      agent writes MewUI apps that actually compile.
    </p>
    <div class="actions">
      <a class="primary" href={`${links.repo}/tree/main/skills`}>Read the agent skill</a>
    </div>
  </section>

  <section id="controls">
    <h2>Controls you expect, in the box</h2>
    <p class="lede">
      Buttons, text input, lists, trees, grids, tabs, menus, toolbars, pickers,
      navigation and the panels to lay them out. The Gallery sample exercises all
      of them, and it runs in the browser.
    </p>
    <div class="shots">
      <figure>
        <img src={asset("light.png")} alt="Gallery with the light theme" width="1200" height="800" loading="lazy" />
        <figcaption>Light theme</figcaption>
      </figure>
      <figure>
        <img src={asset("dark.png")} alt="Gallery with the dark theme" width="1200" height="800" loading="lazy" />
        <figcaption>Dark theme</figcaption>
      </figure>
    </div>
    <div class="actions">
      <a class="primary" href={links.gallery}>Open the Gallery</a>
    </div>
  </section>

  <section id="extensions">
    <h2>Optional extensions</h2>
    <p class="lede">
      The core stays thin. Larger features ship as separate packages you
      reference only when you need them.
    </p>
    <div class="cards">
      {extensions.map((item) => (
        <a class="card" href={item.href}>
          <h3>{item.name}</h3>
          <p>{item.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="platforms">
    <h2>Platforms and rendering backends</h2>
    <p class="lede">
      Windowing runs through a platform host, drawing through a backend. Pick one
      backend at publish time to trim the rest away.
    </p>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Platform</th>
            <th>Host</th>
            <th>Backends</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((row) => (
            <tr>
              <td>{row.platform}</td>
              <td>{row.host}</td>
              <td>{row.backends}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="status">
    <div class="notice">
      <h2>Where the project stands</h2>
      <p>
        MewUI is at {upstream.publishedVersion} and under active development.
        The public API is still being stabilized, so breaking changes can land
        between minor releases. Pin your package version and read the release
        notes before upgrading.
      </p>
      <a href={`${links.repo}/releases`}>Release notes</a>
    </div>
  </section>

  <section id="docs">
    <h2>Documentation</h2>
    <p class="lede">Written alongside the code, in the repository.</p>
    <div class="doc-links">
      {docs.map(([label, file]) => (
        <a href={`${links.repo}/blob/main/docs/${file}`}>{label}</a>
      ))}
    </div>
    <p class="small muted">
      <a href={links.docs}>All documentation</a> is also available in Korean as
      the matching <code>.ko.md</code> files.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .wordmark {
    width: min(19rem, 70%);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4.6vw, 3rem);
  }

  .hero .lede {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero .small {
    margin-top: 1.25rem;
  }

  .shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 24px 60px -30px #00000073;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .actions a {
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    font-weight: 550;
  }

  .actions a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .actions .primary,
  .actions .primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .stat-band {
    border-block: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .stat-row {
    max-width: var(--page);
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .stat strong {
    display: block;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .note {
    margin-top: 1rem;
  }

  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card {
    display: block;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    border-color: var(--accent);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .size-headline {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-bottom: 2rem;
  }

  .size-headline > div {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .size-headline strong {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .size-headline strong span {
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .size-headline p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  th {
    background: var(--bg-soft);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  #size .small {
    margin-top: 1rem;
  }

  .code-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    align-items: start;
  }

  .code {
    margin: 0;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--code-bg);
    color: var(--code-fg);
    font-size: 0.86rem;
    line-height: 1.65;
    overflow-x: auto;
  }

  .code-grid h3 {
    margin: 0 0 0.5rem;
  }

  .code-grid > div p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: 0;
    padding: 0;
  }

  .steps li {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .step {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 650;
  }

  .steps h3 {
    margin: 0 0 0.4rem;
    font-size: 1.02rem;
  }

  .steps p {
    margin: 0;
    font-size: 0.93rem;
  }

  .shots {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    margin-bottom: 2rem;
  }

  .shots figure {
    margin: 0;
  }

  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .shots figcaption {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .notice {
    padding: 2rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }

  .notice h2 {
    margin: 0 0 0.6rem;
    font-size: 1.3rem;
  }

  .notice p {
    margin: 0 0 1rem;
    color: var(--muted);
    max-width: 46rem;
  }

  .doc-links {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .doc-links a {
    padding: 0.7rem 1rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .doc-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  #docs .small {
    margin-top: 1.25rem;
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
