---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";
import Icon from "../components/Icon.astro";
import upstream from "../data/upstream.json";
import { links, asset } from "../config";
import { snippet } from "../lib/snippet";

const MIB = 1024 * 1024;
const mib = (bytes: number) => (bytes / MIB).toFixed(2);
const compact = (value: number) =>
  value >= 1000 ? `${(value / 1000).toFixed(1)}K` : String(value);

const helloRows = upstream.sizes.entries.filter(
  (entry) => entry.sample === "Hello World",
);
const galleryRows = upstream.sizes.entries.filter(
  (entry) => entry.sample === "Gallery",
);
const smallestHello = helloRows.reduce((a, b) =>
  a.executableBytes <= b.executableBytes ? a : b,
);
const measuredOn = new Date(upstream.sizes.generatedAtUtc)
  .toISOString()
  .slice(0, 10);

const stats = [
  { value: compact(upstream.stats.downloads), label: "NuGet downloads" },
  { value: String(upstream.stats.stars), label: "GitHub stars" },
  { value: String(upstream.stats.releases), label: "Releases shipped" },
  { value: "4", label: "Windows, Linux, macOS, browser" },
];

const highlights = [
  {
    icon: "chip",
    title: "NativeAOT and trimming first",
    body: "Explicit code paths and source generated interop, with no reflection based binding. Publish one native executable that runs without a .NET runtime installed.",
  },
  {
    icon: "feather",
    title: "Small by design",
    body: `A Hello World window publishes at ${mib(smallestHello.executableBytes)} MiB. Low memory footprint and fast first frame follow from the same choices.`,
  },
  {
    icon: "brackets",
    title: "C# markup, no XAML",
    body: "Build the UI tree with a fluent API in plain C#. No markup compiler, no designer, no second language to learn.",
  },
  {
    icon: "targets",
    title: "One codebase, four targets",
    body: "Windows, Linux/X11 and macOS desktop hosts, plus a WebAssembly build that runs the same UI in the browser.",
  },
] as const;

const workflow = [
  {
    icon: "download",
    title: "Install",
    body: "Add the package, or drop a single .cs file with a package header and run it.",
  },
  {
    icon: "pen",
    title: "Write",
    body: "Compose controls with fluent C# markup and bind them to plain view models.",
  },
  {
    icon: "refresh",
    title: "Iterate",
    body: "Hot Reload applies edits to the running app, Editor Preview renders it in the IDE, DevTools inspects the live tree.",
  },
  {
    icon: "ship",
    title: "Publish",
    body: "Publish NativeAOT per platform, pick one rendering backend to trim the rest away.",
  },
] as const;

const extensions = [
  {
    icon: "dock",
    name: "MewDock",
    body: "Visual Studio style docking: document and tool tabs, drag rearranging, splits, auto hide, popouts.",
    href: `${links.repo}/tree/main/extensions/MewUI.MewDock`,
  },
  {
    icon: "vector",
    name: "SVG",
    body: "Pure C# SVG parsing and rendering. No System.Drawing, AOT compatible.",
    href: `${links.repo}/tree/main/extensions/MewUI.Svg`,
  },
  {
    icon: "brush",
    name: "Skia",
    body: "SkiaCanvasView for drawing with SkiaSharp, with zero copy GPU interop per backend.",
    href: `${links.repo}/tree/main/extensions/MewUI.Skia`,
  },
  {
    icon: "chart",
    name: "MewCharts",
    body: "Cartesian, pie and polar charts on the LiveChartsCore engine, without a SkiaSharp dependency.",
    href: `${links.repo}/tree/main/extensions/MewUI.MewCharts`,
  },
  {
    icon: "globe",
    name: "WebView2",
    body: "Win32 WebView2 control. Requires the Microsoft Edge WebView2 runtime.",
    href: `${links.repo}/tree/main/extensions/MewUI.WebView2.Win32`,
  },
] as const;

const platforms = [
  { platform: "Windows 10+", host: "Win32", backends: "Direct2D, GDI, MewVG" },
  { platform: "Linux", host: "X11", backends: "MewVG (OpenGL)" },
  { platform: "macOS 12+", host: "AppKit", backends: "MewVG (Metal)" },
  { platform: "Browser", host: "WebAssembly", backends: "MewVG (WebGL2)" },
];

const agentPoints = [
  {
    icon: "book",
    title: "Package recipes",
    body: "Which metapackage to reference for a target, and what a working project file looks like.",
  },
  {
    icon: "brackets",
    title: "Markup API",
    body: "The fluent surface, so generated code compiles instead of inventing methods.",
  },
  {
    icon: "ruler",
    title: "Build and verify",
    body: "How to build, publish and check the result on each platform.",
  },
] as const;

const docs = [
  ["Installation and packages", "Installation.md"],
  ["C# markup", "CSharpMarkup.md"],
  ["Binding", "Binding.md"],
  ["Layout", "Layout.md"],
  ["Styling", "Styling.md"],
  ["Theme", "Theme.md"],
  ["Property system", "PropertySystem.md"],
  ["Items and templates", "ItemsAndTemplates.md"],
  ["Control template", "ControlTemplate.md"],
  ["Custom controls", "CustomControls.md"],
  ["Command system", "CommandSystem.md"],
  ["Application lifecycle", "ApplicationLifecycle.md"],
  ["Hot reload", "HotReload.md"],
  ["Editor preview", "Preview.md"],
];

const helloCode = snippet("Program.cs", "hello");
const bindingCode = snippet("BindingExample.cs", "binding");
const CODE_THEME = "dark-plus";

const title = "MewUI";
const description =
  "A cross-platform, lightweight, code-first .NET GUI framework for NativeAOT and trim friendly desktop apps.";
---

<Base title={title} description={description}>
  <section class="hero">
    <img class="wordmark" src={asset("logo_h-1280.webp")} alt="MewUI" width="420" height="184" />
    <h1>Desktop apps in C#, shipped as one small native file.</h1>
    <p class="lede">
      MewUI is a cross-platform, lightweight, code-first .NET GUI framework.
      No XAML, no designer, no .NET runtime on the target machine.
    </p>
    <div class="actions">
      <a class="primary" href={links.gallery}>Run the demo in your browser</a>
      <a href={links.install}>Get started</a>
      <a href={links.repo}>GitHub</a>
    </div>
    <p class="small muted">
      MIT licensed. .NET {upstream.targetFrameworks.join(" and ").replace(/net/g, "")}.
      Latest release {upstream.publishedVersion}.
    </p>

    <figure class="theme-compare">
      <div class="frame">
        <img
          src={asset("light.png")}
          alt="The MewUI Gallery sample with the light theme"
          width="1619"
          height="1903"
          loading="eager"
        />
        <img
          class="over"
          src={asset("dark.png")}
          alt="The same sample with the dark theme"
          width="1619"
          height="1903"
          loading="eager"
        />
        <span class="tag light">Light</span>
        <span class="tag dark">Dark</span>
        <input
          class="range"
          type="range"
          min="0"
          max="100"
          value="50"
          step="0.1"
          aria-label="Drag to compare the light and dark themes"
        />
        <div class="divider" aria-hidden="true"><span class="knob"></span></div>
      </div>
      <figcaption class="small muted">
        Drag to compare. One theme object, switched at runtime.
      </figcaption>
    </figure>
  </section>

  <div class="stat-band">
    <div class="stat-row">
      {stats.map((stat) => (
        <div class="stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <section id="try" class="split">
    <div>
      <h2>Try it before you install anything</h2>
      <p class="lede">
        One command downloads a single file sample and runs it. No clone, no
        project, no SDK template. Requires the .NET 10 SDK.
      </p>
      <p class="small muted">
        This downloads and executes code from GitHub. Read
        <a href={`${links.repo}/blob/main/samples/FBASample/fba_gallery.cs`}>the file</a>
        first if that matters to you. Prefer not to run anything?
        <a href={links.gallery}>The same Gallery runs in your browser.</a>
      </p>
    </div>
    <CopyCommand command={upstream.tryCommand} />
  </section>

  <section id="why">
    <h2>Why MewUI</h2>
    <p class="lede">
      The framework optimizes for one thing: a small, self contained desktop app
      that starts fast.
    </p>
    <div class="cards">
      {highlights.map((item) => (
        <article class="card">
          <span class="badge"><Icon name={item.icon} /></span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="size" class="split">
    <div>
      <h2>Measured, not claimed</h2>
      <p class="lede">
        Every number here is the main executable of a NativeAOT publish, measured
        by the repository's own size tooling. Binary units, so 1 MB is 1024 KB.
      </p>
      <div class="size-headline">
        <div>
          <strong>{mib(smallestHello.executableBytes)}<span> MiB</span></strong>
          <p>Hello World, {smallestHello.platformBackend}</p>
        </div>
        <div>
          <strong>{mib(galleryRows[0].executableBytes)}<span> MiB</span></strong>
          <p>Gallery, the full control showcase</p>
        </div>
      </div>
      <p class="small muted">
        Measured on {upstream.sizes.measuredOnVersion} at {measuredOn}.
        <a href={links.sizeTools}>Reproduce it with the size tools.</a>
      </p>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Platform / backend</th>
            <th>Hello World</th>
            <th>Gallery</th>
          </tr>
        </thead>
        <tbody>
          {helloRows.map((hello) => {
            const gallery = galleryRows.find(
              (row) => row.platformBackend === hello.platformBackend,
            );
            return (
              <tr>
                <td>{hello.platformBackend}</td>
                <td>{mib(hello.executableBytes)} MiB</td>
                <td>{gallery ? `${mib(gallery.executableBytes)} MiB` : "-"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section id="code" class="split">
    <div>
      <h2>The whole app is C#</h2>
      <p class="lede">
        Controls are composed with a fluent API. What you read is what runs, and
        every example on this page is compiled against the published package
        before the site deploys.
      </p>
      <a class="text-link" href={`${links.repo}/blob/main/docs/CSharpMarkup.md`}>
        Read the markup guide
      </a>
    </div>
    <div class="code-card">
      <Code code={helloCode} lang="csharp" theme={CODE_THEME} />
    </div>
  </section>

  <section id="binding" class="split reverse">
    <div>
      <h2>Bindings without reflection</h2>
      <p class="lede">
        A source is an observable value, an ordinary INotifyPropertyChanged view
        model, or another element's property. Dotted paths are decomposed into
        per step subscriptions at compile time, so trimming and AOT keep working.
      </p>
      <a class="text-link" href={`${links.repo}/blob/main/docs/Binding.md`}>
        Read the binding guide
      </a>
    </div>
    <div class="code-card">
      <Code code={bindingCode} lang="csharp" theme={CODE_THEME} />
    </div>
  </section>

  <section id="workflow">
    <h2>How you work</h2>
    <ol class="steps">
      {workflow.map((item, index) => (
        <li>
          <span class="badge"><Icon name={item.icon} /></span>
          <h3><span class="step-index">{index + 1}</span>{item.title}</h3>
          <p class="muted">{item.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="ai" class="split">
    <div>
      <h2>Built to be driven by coding agents</h2>
      <p class="lede">
        MewUI ships an agent skill for Claude Code, Codex and GitHub Copilot. It
        gives the agent the facts it would otherwise guess, so what it writes
        compiles.
      </p>
      <div class="actions">
        <a class="primary" href={`${links.repo}/tree/main/skills`}>Read the agent skill</a>
      </div>
    </div>
    <ul class="feature-list">
      {agentPoints.map((item) => (
        <li>
          <span class="badge"><Icon name={item.icon} /></span>
          <div>
            <h3>{item.title}</h3>
            <p class="muted">{item.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="controls">
    <h2>Controls you expect, in the box</h2>
    <p class="lede">
      Buttons, text input, lists, trees, grids, tabs, menus, toolbars, pickers,
      navigation, and the panels to lay them out. The Gallery sample exercises
      all of them, and it runs in the browser with no install.
    </p>
    <div class="actions">
      <a class="primary" href={links.gallery}>Open the Gallery</a>
      <a href={`${links.repo}/tree/main/samples`}>Browse the samples</a>
    </div>
  </section>

  <section id="extensions">
    <h2>Optional extensions</h2>
    <p class="lede">
      The core stays thin. Larger features ship as separate packages you
      reference only when you need them.
    </p>
    <div class="cards">
      {extensions.map((item) => (
        <a class="card" href={item.href}>
          <span class="badge"><Icon name={item.icon} /></span>
          <h3>{item.name}</h3>
          <p>{item.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="platforms" class="split">
    <div>
      <h2>Platforms and rendering backends</h2>
      <p class="lede">
        Windowing runs through a platform host, drawing through a backend. Pick
        one backend at publish time to trim the rest away.
      </p>
      <a class="text-link" href={links.install}>Installation and packages</a>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Platform</th>
            <th>Host</th>
            <th>Backends</th>
          </tr>
        </thead>
        <tbody>
          {platforms.map((row) => (
            <tr>
              <td>{row.platform}</td>
              <td>{row.host}</td>
              <td>{row.backends}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="status">
    <div class="notice">
      <h2>Where the project stands</h2>
      <p>
        MewUI is at {upstream.publishedVersion} and under active development.
        The public API is still being stabilized, so breaking changes can land
        between minor releases. Pin your package version and read the release
        notes before upgrading.
      </p>
      <a class="text-link" href={`${links.repo}/releases`}>Release notes</a>
    </div>
  </section>

  <section id="docs">
    <h2>Documentation</h2>
    <p class="lede">Written alongside the code, in the repository.</p>
    <div class="doc-links">
      {docs.map(([label, file]) => (
        <a href={`${links.repo}/blob/main/docs/${file}`}>{label}</a>
      ))}
    </div>
    <p class="small muted">
      <a href={links.docs}>All documentation</a> is also available in Korean as
      the matching <code>.ko.md</code> files.
    </p>
  </section>
</Base>

<script>
  for (const range of document.querySelectorAll<HTMLInputElement>(
    ".theme-compare .range",
  )) {
    const frame = range.closest<HTMLElement>(".frame");
    if (frame === null) {
      continue;
    }

    const apply = () => frame.style.setProperty("--pos", `${range.value}%`);
    range.addEventListener("input", apply);
    apply();
  }
</script>

<style>
  .hero {
    text-align: center;
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .wordmark {
    width: min(19rem, 70%);
    height: auto;
    margin-bottom: 1.5rem;
  }

  .hero h1 {
    max-width: 22ch;
    margin: 0 auto 1rem;
    font-size: clamp(2rem, 4.6vw, 3rem);
  }

  .hero .lede {
    max-width: 42rem;
    margin: 0 auto 2rem;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .hero .actions {
    justify-content: center;
  }

  .hero .small {
    margin-top: 1.25rem;
  }

  .theme-compare {
    max-width: 46rem;
    margin: 3rem auto 0;
  }

  /* The two captures are the same window at the same pixel size, so revealing
     one over the other reads as a single app changing theme. */
  .frame {
    --pos: 50%;
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 26px 70px -34px #00000080;
    touch-action: pan-y;
  }

  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .frame .over {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }

  .divider {
    pointer-events: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.4rem;
    height: 2.4rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 2px 12px #0000004d;
  }

  .knob::before,
  .knob::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
  }

  .knob::before {
    left: 0.55rem;
    border-right: 6px solid #ffffff;
    transform: translateY(-50%);
  }

  .knob::after {
    right: 0.55rem;
    border-left: 6px solid #ffffff;
    transform: translateY(-50%);
  }

  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    background: transparent;
  }

  .range::-webkit-slider-thumb {
    appearance: none;
    width: 1px;
    height: 100%;
  }

  .range::-moz-range-thumb {
    width: 1px;
    height: 100%;
    border: none;
  }

  .range:focus-visible ~ .divider {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #00000073;
    color: #ffffff;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .tag.light {
    left: 0.75rem;
  }

  .tag.dark {
    right: 0.75rem;
  }

  .theme-compare figcaption {
    margin-top: 0.9rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .actions a {
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: inherit;
    text-decoration: none;
    font-weight: 550;
  }

  .actions a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .actions .primary,
  .actions .primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  .text-link {
    display: inline-block;
    font-weight: 550;
  }

  .stat-band {
    border-block: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .stat-row {
    max-width: var(--page);
    margin: 0 auto;
    padding: 2rem 1.25rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .stat strong {
    display: block;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Uno style alternating columns: the claim on one side, the evidence on the
     other. .reverse puts the evidence first on wide screens only. */
  .split {
    display: grid;
    gap: 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }

  .split > div > h2,
  .split > div > h2 + .lede {
    max-width: 34rem;
  }

  .split > div > h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
  }

  .split > div > .lede {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .split.reverse > :first-child {
    order: 2;
  }

  .badge {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.9rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card {
    display: block;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: inherit;
    text-decoration: none;
  }

  a.card:hover {
    border-color: var(--accent);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .feature-list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-list .badge {
    margin-bottom: 0;
  }

  .feature-list h3 {
    margin: 0.15rem 0 0.25rem;
    font-size: 1.02rem;
  }

  .feature-list p {
    margin: 0;
    font-size: 0.95rem;
  }

  .size-headline {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-bottom: 1.25rem;
  }

  .size-headline > div {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--accent-soft);
  }

  .size-headline strong {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .size-headline strong span {
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .size-headline p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  th {
    background: var(--bg-soft);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
